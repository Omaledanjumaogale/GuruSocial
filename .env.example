# GuruSocial runtime configuration.
# Copy to .env and fill in. Without VITE_CONVEX_URL the app runs on the
# complete in-browser demo provider (full feature rendering, local data).
# With VITE_CONVEX_URL set, live Convex data is used; if the backend is
# unreachable the demo provider transparently takes over until it returns.
VITE_CONVEX_URL=
VITE_CONVEX_HTTP_URL=
VITE_PUBLIC_APP_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
