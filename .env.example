# GuruSocial frontend configuration (public, embedded at build time).
# Copy to .env for a live build. Without VITE_CONVEX_URL the app runs on the
# complete in-browser demo provider; real data replaces it as soon as the
# backend is reachable.
VITE_CONVEX_URL=
VITE_CONVEX_HTTP_URL=
VITE_PUBLIC_APP_URL=https://gurusocial.ewinproject.org
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=

# Server-side only — set these on the Convex deployment, never in the browser
# bundle and never in source control:
#
#   RESEND_API_KEY              transactional email (welcome + admin test)
#   AGNES_AI_KEY                LLM key for server-side draft generation
#   AGNES_BASE_URL              default https://apihub.agnes-ai.com/v1
#   AGNES_MODEL                 default agnes-3.0-flash
#   GOOGLE_CLIENT_ID            Google OAuth client id
#   GOOGLE_CLIENT_SECRET        Google OAuth client secret
#   GITHUB_CLIENT_ID            GitHub OAuth client id
#   GITHUB_CLIENT_SECRET        GitHub OAuth client secret
#   SUPER_ADMIN_EMAIL           operator console identity
#   SUPER_ADMIN_PASSWORD        operator console password
#   ADMIN_SESSION_SECRET        admin session signing secret
#   R2_ACCOUNT_ID               Cloudflare account id
#   R2_ACCESS_KEY_ID            R2 S3-compatible access key
#   R2_SECRET_ACCESS_KEY        R2 S3-compatible secret
#   R2_BUCKET                   R2 bucket name
#   R2_PUBLIC_BASE_URL          optional public CDN base for uploaded media
#   EWIN_HUB_SECRET             shared HMAC secret with the E-WIN hub
