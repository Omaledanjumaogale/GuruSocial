{
	"name": "gurusocial",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"description": "GuruSocial — the harmonized enterprise-grade social media command center: unified posting API, MCP server, AI composer, scheduling, analytics, inbox, CRM and agent automations across 15 platforms.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/postbuild-static-shells.mjs",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"typecheck:convex": "tsc --noEmit -p convex",
		"convex:dev": "convex dev --local",
		"convex:deploy": "convex deploy",
		"verify:static": "node scripts/verify-static.mjs",
		"assets:check": "node scripts/verify-assets.mjs",
		"production:verify": "node scripts/verify-production.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.1.11",
		"@types/node": "^26.6.10",
		"sharp": "^0.35.5",
		"svelte": "^5.28.0",
		"svelte-check": "^4.1.0",
		"tailwindcss": "^4.1.11",
		"typescript": "^5.8.0",
		"vite": "^6.2.0"
	},
	"dependencies": {
		"convex": "^1.25.0"
	}
}
