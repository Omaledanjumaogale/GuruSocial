# Cloudflare Pages headers.
# Hashed build assets and versioned artwork are immutable; the shell, worker and
# manifest must revalidate so a new deployment is picked up immediately.

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/images/generated/*
  Cache-Control: public, max-age=31536000, immutable

/images/responsive/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/404.html
  Cache-Control: no-cache

/build-info.json
  Cache-Control: no-cache
